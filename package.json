{
  "name": "sedem-ads-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Public portfolio showcase: independent reference implementation, synthetic demo data, documentation.",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "npm run typecheck -w packages/analytics-core",
    "build": "npm run build -w packages/analytics-core",
    "test": "npm run test -w packages/analytics-core",
    "example": "npm run build && node examples/quickstart.mjs",
    "samples": "npm run build && node examples/generate-samples.mjs",
    "privacy-scan": "node scripts/privacy-scan.mjs",
    "privacy-scan:history": "node scripts/privacy-scan.mjs --git-history",
    "test:scripts": "node --test scripts/privacy-scan.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test && node examples/quickstart.mjs && npm run privacy-scan && npm run test:scripts"
  }
}
